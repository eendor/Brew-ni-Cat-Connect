# Phase 1 requires no runtime environment variables.
# The following names are reserved for the approved later Supabase phase.
# Keep values empty in source control. Never place a service-role key here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Future server-only integrations will document their variable names in the
# phase that introduces them. Real secrets belong in the deployment secret store.
