# Phase 2 public read-only menu configuration.
# Keep every value empty in source control. Use local/deployment secret stores.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Phase 4 Place order for pickup. Leave empty (off) until the shop's POS can
# see online orders; set to "enabled" and redeploy to turn it on.
NEXT_PUBLIC_ONLINE_ORDERING=

# Phase 9 ads in the mini-game area (FR-090): the public 32-character key of the
# Adsterra 300x250 banner unit. Leave empty to keep ads off.
NEXT_PUBLIC_AD_KEY=

# Server-only names are documented for environment parity. The Phase 2 website
# does not import or require them at runtime.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Phase 7 Messenger assistant (server only, never NEXT_PUBLIC_). The app secret
# checks Meta's signature on each webhook call, the verify token answers Meta's
# subscription check, and the Page access token sends the replies. Copy them
# from the Meta app's settings into the deployment's secret store.
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
# Optional (ADR-031): Gemini smart replies for typed Messenger questions.
# Server only. Without it, typed questions get the "our staff will reply" message.
GEMINI_API_KEY=
# Optional: comma-separated model names to try in order.
GEMINI_MODELS=
